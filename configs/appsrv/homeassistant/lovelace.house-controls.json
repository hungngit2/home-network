{
  "title": "Controls",
  "views": [
    {
      "title": "Controls",
      "path": "controls",
      "icon": "mdi:remote",
      "type": "sections",
      "max_columns": 3,
      "sections": [
        {
          "type": "grid",
          "cards": [
            {
              "type": "heading",
              "heading": "Kitchen",
              "heading_style": "title",
              "icon": "mdi:silverware-fork-knife"
            },
            {
              "type": "custom:mushroom-fan-card",
              "entity": "fan.kitchen_fan",
              "name": "Fan",
              "secondary_info": "state",
              "icon_animation": true,
              "fill_container": true,
              "show_percentage_control": true,
              "show_direction_control": true,
              "collapsible_controls": false,
              "tap_action": {
                "action": "toggle"
              },
              "hold_action": {
                "action": "more-info"
              },
              "grid_options": {
                "columns": 12
              }
            },
            {
              "type": "custom:mushroom-chips-card",
              "alignment": "center",
              "chips": [
                {
                  "type": "template",
                  "content": "Natural",
                  "icon": "mdi:weather-windy",
                  "icon_color": "{{ 'cyan' if is_state('input_select.kitchen_fan_preset', 'natural') else 'grey' }}",
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "fan.set_preset_mode",
                    "target": {
                      "entity_id": "fan.kitchen_fan"
                    },
                    "data": {
                      "preset_mode": "natural"
                    }
                  }
                },
                {
                  "type": "template",
                  "content": "Sleep",
                  "icon": "mdi:weather-night",
                  "icon_color": "{{ 'cyan' if is_state('input_select.kitchen_fan_preset', 'sleep') else 'grey' }}",
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "fan.set_preset_mode",
                    "target": {
                      "entity_id": "fan.kitchen_fan"
                    },
                    "data": {
                      "preset_mode": "sleep"
                    }
                  }
                },
                {
                  "type": "template",
                  "content": "Light",
                  "icon": "mdi:lightbulb",
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "button.press",
                    "target": {
                      "entity_id": "button.1b_fan_light_light_on_off"
                    }
                  }
                },
                {
                  "type": "template",
                  "content": "Off",
                  "icon": "mdi:power",
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "button.press",
                    "target": {
                      "entity_id": "button.1b_fan_light_power_off"
                    }
                  }
                }
              ],
              "grid_options": {
                "columns": 12
              }
            },
            {
              "type": "custom:mushroom-chips-card",
              "alignment": "center",
              "chips": [
                {
                  "type": "template",
                  "content": "1h",
                  "icon": "mdi:timer-outline",
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "button.press",
                    "target": {
                      "entity_id": "button.1b_fan_light_timer_1h"
                    }
                  }
                },
                {
                  "type": "template",
                  "content": "2h",
                  "icon": "mdi:timer-outline",
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "button.press",
                    "target": {
                      "entity_id": "button.1b_fan_light_timer_2h"
                    }
                  }
                },
                {
                  "type": "template",
                  "content": "4h",
                  "icon": "mdi:timer-outline",
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "button.press",
                    "target": {
                      "entity_id": "button.1b_fan_light_timer_4h"
                    }
                  }
                }
              ],
              "grid_options": {
                "columns": 12
              }
            }
          ]
