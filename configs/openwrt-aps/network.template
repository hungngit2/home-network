# OpenWrt AP Network Template (DSA VLAN Filtering)
# Managed by scripts/setup-openwrt-ap.sh

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option packet_steering '1'
	option ula_prefix 'fd39:10::/48'

config device
	option name 'br-lan'
	option type 'bridge'
	option stp '1'
	option igmp_snooping '1'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'wan'
	list ports 'lotus-mesh'

config interface 'lan'
	option proto 'static'
	option device 'br-lan.1'
	option ipaddr '${AP_IP}'
	option netmask '255.255.255.0'
	option gateway '${ROUTER_IP}'
	option delegate '0'
	option peerdns '0'
	list dns '${DNS_SERVER}'
	list dns '127.0.0.1'

config interface 'iot'
	option proto 'none'
	option device 'br-lan.10'

config interface 'guest'
	option proto 'none'
	option device 'br-lan.12'

config bridge-vlan
	option device 'br-lan'
	option vlan '1'
	list ports 'lan1'
	list ports 'lotus-mesh:t'
	list ports 'wan'

config bridge-vlan
	option device 'br-lan'
	option vlan '10'
	list ports 'lan2'
	list ports 'lotus-mesh:t'
	list ports 'wan:t'

config bridge-vlan
	option device 'br-lan'
	option vlan '12'
	list ports 'lotus-mesh:t'
	list ports 'wan:t'
